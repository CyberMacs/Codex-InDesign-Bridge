{
  "manifestVersion": 5,
  "id": "com.istvan.codex.indesignbridge",
  "name": "Codex InDesign Bridge",
  "version": "0.3.1",
  "main": "index.html",
  "host": {"app": "ID", "minVersion": "18.5.0"},
  "description": {"default": "Local, consent-based bridge between Codex and an open InDesign session.", "hu": "Helyi, jóváhagyásalapú kapcsolat a Codex és a megnyitott InDesign között."},
  "icons": [{"width": 24, "height": 24, "path": "icons/bridge-icon.svg", "scale": [1, 2], "theme": ["all"], "species": ["generic", "pluginList"]}],
  "entrypoints": [{"type": "panel", "id": "bridgePanel", "label": {"default": "Codex InDesign Bridge", "hu": "Codex InDesign Bridge"}, "minimumSize": {"width": 320, "height": 340}, "preferredDockedSize": {"width": 360, "height": 420}}],
  "requiredPermissions": {"localFileSystem": "request"}
}
